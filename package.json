{
  "name": "cbs-customs-platform",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "postinstall": "playwright install chromium",
    "pretest": "playwright install chromium",
    "bddgen": "bddgen",
    "test": "npm run bddgen && playwright test",
    "test:allure": "npm run pretest && npm run bddgen && playwright test",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "npm run allure:generate && allure open allure-report --host 127.0.0.1 --port 5050",
    "report:playwright": "playwright show-report playwright-report --host 127.0.0.1 --port 9323",
    "report:allure": "allure open allure-report --host 127.0.0.1 --port 5050",
    "report:allure:refresh": "npm run allure:generate",
    "test:unit": "jest",
    "test:unit:watch": "jest --watch",
    "test:unit:coverage": "jest --coverage",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.62.1",
    "@types/jest": "^29.5.0",
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.12.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.0.0",
    "fast-xml-parser": "^4.4.0",
    "globals": "^15.0.0",
    "jest": "^29.5.0",
    "playwright-bdd": "^9.2.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.0.0"
  }
}
